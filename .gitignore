# Live-linked folders also hold runtime files the apps write; keep only the configs.
config/powershell/*
!config/powershell/Microsoft.PowerShell_profile.ps1
!config/powershell/profile.ps1
!config/powershell/powershell.config.json

config/windows-terminal/*
!config/windows-terminal/settings.json

config/glazewm/*
!config/glazewm/config.yaml

# Zebar (removed 2026-10-31): what it generated in a checkout (its theme.css, its client, WebView
# caches) until the migration clears it (migrations/2026-10-31-zebar-out.ps1).
zebar/
src/music/bin/
src/music/obj/
test/menu-app.Tests/bin/
test/menu-app.Tests/obj/

# Scratch output: local builds and the release tests (bin/install-binaries.ps1, docs/releases.md)
# write here, never into the live ~/.local/bin or %LOCALAPPDATA%\system-menu.
scratch/

# Written by src/agent/backends/opencode.ps1: the omawin agent for the OpenCode service.
.opencode/

# Agents' worktrees (Claude Code)
.claude/worktrees/
src/cli/bin/
src/cli/obj/
test/cli.Tests/bin/
test/cli.Tests/obj/
out/
src/bundle/bin/
src/bundle/obj/
src/thumbs/bin/
src/thumbs/obj/

# Links an older menu app still reads (migrations/2026-10-31-repo-layout.ps1), until the release after the move.
/launcher
/bar

# The plugins' QML host's Rust build.
src/qs-host/target/
src/qs-host/.qmlls.ini
