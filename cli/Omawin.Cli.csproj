<Project Sdk="Microsoft.NET.Sdk">
  <!-- The omawin command (roadmap 2.11): bin/omawin.cs moved to .NET 9 Native AOT, built in CI
       and shipped in the release. Same bin/commands.txt, same routing; bin/omawin.cs stays as the
       from-source fallback until every builtin has moved here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>omawin</AssemblyName>
    <RootNamespace>Omawin.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- LibraryImport generates the P/Invoke stubs -->
  </PropertyGroup>
</Project>
