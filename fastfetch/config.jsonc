// omawin's fastfetch, laid out like Omarchy's (About): the logo, then Hardware, Software and
// Age / Uptime / Update in gray boxes. Linked to ~/.config/fastfetch (install/shell.ps1).
// Colors are ANSI names (green, blue, magenta, 90 = gray), so the terminal's theme colors them.
// Command modules run in parallel through cmd (fastfetch's default on Windows, far quicker than
// PowerShell), or call the program directly (shell = the exe, param = ""). No double quotes in
// a cmd line: fastfetch passes them on as \" and cmd doesn't unescape them. fastfetch doesn't
// know noctty's font, so that row reads noctty's config.
// The logo is fastfetch/logo.txt: Omarchy's own icon, byte for byte (basecamp/omarchy icon.txt,
// MIT; see fastfetch/NOTICE). A config can't branch, so
// for your own (say ~/omawin-work/branding/about.txt), run: fastfetch --logo <file>
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "green" },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": "\uf109 PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├\uf4bc",
      "showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├\ue266",
      "format": "{name}",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├\udb84\udd04",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ ├\udb80\udeca",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├\uefc5",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "└ └\udb81\udce1",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\uf17a OS",
      "keyColor": "blue",
      "text": "git -C %USERPROFILE%\\omawin describe --tags --match v* --exact-match 2>nul || git -C %USERPROFILE%\\omawin rev-parse --short HEAD",
      "format": "omawin {result}"
    },
    {
      "type": "command",
      "key": "│ ├\udb81\ude2c",
      "keyColor": "blue",
      "text": "git -C %USERPROFILE%\\omawin branch --show-current"
    },
    {
      "type": "kernel",
      "key": "│ ├\uf013",
      "keyColor": "blue",
      "format": "Windows {release}"
    },
    {
      "type": "command",
      "key": "│ ├\uf488",
      "keyColor": "blue",
      "shell": "glazewm",
      "param": "",
      "text": "--version",
      "format": "GlazeWM {result~8}"
    },
    {
      "type": "terminal",
      "key": "│ ├\uf489",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ ├\udb80\udfd6",
      "disabled": [],
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│ ├\udb83\ude0c",
      "keyColor": "blue",
      "text": "type %LOCALAPPDATA%\\launcher\\theme",
      "format": "{result} \u001b[39m●\u001b[37m●\u001b[36m●\u001b[35m●\u001b[34m●\u001b[33m●\u001b[32m●\u001b[31m●"
    },
    {
      "type": "command",
      "key": "└ └\uf031",
      "keyColor": "blue",
      "text": "findstr /b font-family %USERPROFILE%\\omawin\\noctty\\config.ghostty",
      "format": "{result~14}"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "disk",
      "key": "\udb86\udd9f OS Age",
      "keyColor": "magenta",
      "folders": "C:\\",
      "format": "{days} days"
    },
    {
      "type": "uptime",
      "key": "\udb86\uded0 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "\ueb29 Update",
      "keyColor": "magenta",
      "text": "git -C %USERPROFILE%\\omawin log -1 --format=%cs%x20(%cr)"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
