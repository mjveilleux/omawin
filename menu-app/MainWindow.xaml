<Window
    x:Class="SystemMenu.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="System Menu">

    <!-- Colors are set from the theme in code (MainWindow.xaml.cs, ApplyTheme). The window is
         as tall as its rows (up to MaxRows, then they scroll). -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- Search: where you are (chips) and what you type, drawn here; the real (invisible)
             TextBox takes the keys. -->
        <Grid Padding="18,0,18,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SearchIcon" FontSize="18" VerticalAlignment="Center" />
            <StackPanel x:Name="Crumbs" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="QueryText" FontSize="19" />
                <Border x:Name="Caret" Width="2" Height="22" Margin="1,0,0,0" CornerRadius="1" VerticalAlignment="Center" />
                <TextBlock x:Name="Placeholder" FontSize="19" Margin="4,0,0,0" />
            </StackPanel>
            <TextBox x:Name="Input" Grid.Column="2" Opacity="0" Width="1" Height="1"
                     HorizontalAlignment="Left" IsSpellCheckEnabled="False" />
        </Grid>

        <!-- A hairline in the theme's colors, with a soft light drifting along it. -->
        <Grid x:Name="DividerLine" Grid.Row="1">
            <Border x:Name="Divider" Opacity="0.7" />
            <Border x:Name="Sheen" Width="180" HorizontalAlignment="Left" />
        </Grid>

        <!-- The rows; in the file finder also folder chips above them and a preview beside. -->
        <Grid x:Name="Body" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Scopes" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                        Padding="14,10,14,2" Visibility="Collapsed" />
            <!-- The rows (reused from one search to the next: MainWindow.xaml.cs, RowView), or the
                 tiles of a home screen or the theme picker (MainWindow.Tiles.cs). Scrolled by
                 moving ListLayer (Scroll), so held keys and the wheel glide instead of jumping;
                 Pane is what slides in and out between levels. -->
            <Grid x:Name="Viewport" Grid.Row="1" Padding="8,8,8,8" Background="Transparent">
                <Canvas x:Name="Pane">
                    <Grid x:Name="ListLayer">
                        <StackPanel x:Name="Rows" Spacing="2" />
                        <Grid x:Name="Tiles" ColumnSpacing="6" RowSpacing="6" Visibility="Collapsed" />
                    </Grid>
                </Canvas>
            </Grid>
            <Border x:Name="Preview" Grid.Row="1" Grid.Column="1" Margin="0,8,12,10" Padding="18,16,18,16"
                    CornerRadius="12" BorderThickness="1" Visibility="Collapsed">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="PreviewArt" Height="150" CornerRadius="10" />
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock x:Name="PreviewName" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="PreviewPath" Orientation="Horizontal" Spacing="4" />
                    </StackPanel>
                    <StackPanel x:Name="PreviewFacts" Grid.Row="2" Orientation="Horizontal" Spacing="8" />
                    <Border x:Name="PreviewTextBox" Grid.Row="3" CornerRadius="8" Padding="12,10,12,10">
                        <TextBlock x:Name="PreviewText" FontSize="11.5" TextWrapping="NoWrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer: what's shown (or the theme) on the left, keys on the right. -->
        <Grid x:Name="FooterBar" Grid.Row="3" Padding="16,0,12,0">
            <TextBlock x:Name="FooterLeft" FontSize="12" VerticalAlignment="Center" />
            <StackPanel x:Name="Keys" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
