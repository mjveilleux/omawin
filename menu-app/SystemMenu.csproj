<!--
  The menu app: the system menu (Win+Alt+Space), launcher (Win+Space), file finder and
  screenshots, as a WinUI 3 window in the current theme (themes/*.json). Built by build.ps1
  into %LOCALAPPDATA%\system-menu.
  Unpackaged, and carries its own copy of the Windows App SDK, so nothing else is installed.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SystemMenu</RootNamespace>
    <AssemblyName>SystemMenu</AssemblyName>
    <!-- x64 by default; CI builds win-arm64 as well (-p:RuntimeIdentifier=win-arm64 -p:Platform=arm64
         -p:Platforms=arm64, .github/workflows/release.yml), so an ARM64 PC downloads the app
         instead of building it. -->
    <Platforms Condition="'$(Platforms)' == ''">x64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- The release this build is from: CI passes -p:OmawinRelease=v0.1.0; a build off a checkout
         says (dev). Read with Get-Item SystemMenu.exe | % VersionInfo | % ProductVersion. -->
    <OmawinRelease Condition="'$(OmawinRelease)' == ''">(dev)</OmawinRelease>
    <InformationalVersion>$(OmawinRelease)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Use the Windows App SDK's own resource (PRI) tools, so `dotnet build` works without Visual Studio. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>false</SelfContained>
    <!-- Compiled ahead of time (14 MB more). On an idle PC it starts no faster (~0.6 s either
         way), but at sign-in, with the processor busy, it took 16 s to be ready; this is to see
         whether skipping .NET's compiling helps there (omawin profile login). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main (App.xaml.cs) checks for a running copy before starting WinUI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- fff's C library (file search), fetched by build.ps1. -->
    <None Include="lib\fff_c.dll" CopyToOutputDirectory="PreserveNewest" Link="fff_c.dll" Condition="Exists('lib\fff_c.dll')" />
  </ItemGroup>
  <!-- build.ps1 -Aot: one native program (Native AOT), to see what it does for a start at sign-in
       (the bar is to live here, docs/native-bar.md). WinForms can't be compiled that way, so
       for now that build has no screenshot overlay (Aot/SnipStub.cs stands in for Snip.cs). -->
  <PropertyGroup Condition="'$(OmawinAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);OMAWIN_AOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(OmawinAot)' == 'true'">
    <Compile Remove="Snip.cs" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(OmawinAot)' != 'true'">
    <Compile Remove="Aot\**" />
    <!-- The screenshot overlay (Snip.cs) is a plain WinForms window; referenced as a framework
         only, since UseWindowsForms would also switch on WPF's XAML build, which clashes with
         WinUI's. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <!-- QR reading in the snip overlay (omawin capture qr): ZXing's decoder, managed, ~0.5 MB. -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <!-- The built-in display's brightness is only reachable over WMI (root\wmi). -->
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>
</Project>
