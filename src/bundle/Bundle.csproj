<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the tools bundle (install/tools.txt) in CI; run it with a tag and an output folder.
       Runs anywhere .NET runs; the release job runs it on Linux. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Omawin.Bundle</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>
