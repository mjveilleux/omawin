<Project Sdk="Microsoft.NET.Sdk">
  <!-- The community theme index, made in CI (roadmap 1.10): run it with an output folder.
       Runs anywhere .NET runs; .github/workflows/community-themes.yml runs it on Linux weekly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Omawin.CommunityThemes</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The menu app's own reader of the index (pure: no WinUI), so what's written here is what it reads. -->
    <Compile Include="..\..\shell\menu-app\Community.cs" Link="Community.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Decodes omarchy.org's WebP screenshots and themes' PNG / JPEG pictures; MIT. As src/thumbs. -->
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
  </ItemGroup>
</Project>
