<Project Sdk="Microsoft.NET.Sdk">
  <!-- The plugin gallery's index, made in CI (roadmap 4.10): run it with an output folder.
       Runs anywhere .NET runs; the release job runs it on Linux. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Omawin.PluginGallery</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The menu app's own reading of the index and of a manifest (pure: no WinUI), so the file
         written here is the one the gallery page reads. -->
    <Compile Include="..\..\shell\menu-app\Plugins\GalleryIndex.cs" Link="GalleryIndex.cs" />
    <Compile Include="..\..\shell\menu-app\Plugins\Manifest.cs" Link="Manifest.cs" />
  </ItemGroup>
</Project>
