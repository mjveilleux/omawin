    <Compile Include="..\..\shell\menu-app\Contrast.cs" Link="Linked\Contrast.cs" />
    <Compile Include="..\..\shell\menu-app\IconScale.cs" Link="Linked\IconScale.cs" />
    <Compile Include="..\..\shell\menu-app\PackageLogo.cs" Link="Linked\PackageLogo.cs" />
    <Compile Include="..\..\shell\menu-app\ThemePictures.cs" Link="Linked\ThemePictures.cs" />
    <Compile Include="..\..\shell\menu-app\MotionTokens.cs" Link="Linked\MotionTokens.cs" />
    <Compile Include="..\..\shell\menu-app\RowWindow.cs" Link="Linked\RowWindow.cs" />
