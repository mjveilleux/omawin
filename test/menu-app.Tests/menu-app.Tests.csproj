<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the menu app's pure parts (no WinUI, no P/Invoke, no files): they build and
       run anywhere, on Windows or Linux. A sibling of shell/menu-app/, not inside it, because the WinUI
       project compiles every .cs file below it. Run: dotnet test menu-app.Tests -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SystemMenu.Tests</RootNamespace>
    <!-- Runs on a newer .NET when 9 isn't installed (a cloud session with only .NET 10). -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- The pure files, linked from the menu app. Keep them free of WinUI and Windows calls. -->
    <Compile Include="..\..\shell\menu-app\Fuzzy.cs" Link="Linked\Fuzzy.cs" />
    <Compile Include="..\..\shell\menu-app\Search\Result.cs" Link="Linked\Search\Result.cs" />
    <Compile Include="..\..\shell\menu-app\Search\QueryParser.cs" Link="Linked\Search\QueryParser.cs" />
    <Compile Include="..\..\shell\menu-app\Search\Merger.cs" Link="Linked\Search\Merger.cs" />
    <Compile Include="..\..\shell\menu-app\Settings\Catalog.cs" Link="Linked\Settings\Catalog.cs" />
    <Compile Include="..\..\shell\menu-app\Plugins\Manifest.cs" Link="Linked\Plugins\Manifest.cs" />
    <Compile Include="..\..\shell\menu-app\Plugins\ManifestCheck.cs" Link="Linked\Plugins\ManifestCheck.cs" />
    <Compile Include="..\..\shell\menu-app\Plugins\Protocol.cs" Link="Linked\Plugins\Protocol.cs" />
    <Compile Include="..\..\shell\menu-app\Contrast.cs" Link="Linked\Contrast.cs" />
    <Compile Include="..\..\shell\menu-app\IconScale.cs" Link="Linked\IconScale.cs" />
    <Compile Include="..\..\shell\menu-app\PackageLogo.cs" Link="Linked\PackageLogo.cs" />
    <Compile Include="..\..\shell\menu-app\ThemePictures.cs" Link="Linked\ThemePictures.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
