<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for omawin-windows' pure parts (src/windows: Phase 8's fixes): the hosts file's rules,
       the event log's sentences, the startup switch's bytes, the socket tables, the clipboard's
       transforms, the Wi-Fi code. No Windows calls, so they run on Linux (.github/workflows/test.yml).
       The files are linked, not referenced: the exe itself only runs on Windows. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Omawin.Windows.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/windows/Files/Holders.cs" Link="windows/Holders.cs" />
    <Compile Include="../../src/windows/Health/HealthEvents.cs" Link="windows/HealthEvents.cs" />
    <Compile Include="../../src/windows/Health/DeviceHealth.cs" Link="windows/DeviceHealth.cs" />
    <Compile Include="../../src/windows/Health/UpdateSuspects.cs" Link="windows/UpdateSuspects.cs" />
    <Compile Include="../../src/windows/Startup/StartupItems.cs" Link="windows/StartupItems.cs" />
    <Compile Include="../../src/windows/Admin/AdminScripts.cs" Link="windows/AdminScripts.cs" />
    <Compile Include="../../src/windows/Net/HostsFile.cs" Link="windows/HostsFile.cs" />
    <Compile Include="../../src/windows/Net/SocketTable.cs" Link="windows/SocketTable.cs" />
    <Compile Include="../../src/windows/Net/Connections.cs" Link="windows/Connections.cs" />
    <Compile Include="../../src/windows/Net/DnsPresets.cs" Link="windows/DnsPresets.cs" />
    <Compile Include="../../src/windows/Top/ProcessGroups.cs" Link="windows/ProcessGroups.cs" />
    <Compile Include="../../src/windows/Clip/Transforms.cs" Link="windows/Transforms.cs" />
    <Compile Include="../../src/windows/Wifi/WifiShare.cs" Link="windows/WifiShare.cs" />
    <Compile Include="../../src/windows/Updates/UpdatePlan.cs" Link="windows/UpdatePlan.cs" />
    <Compile Include="../../src/windows/Net/ProxySettings.cs" Link="windows/ProxySettings.cs" />
    <Compile Include="../../src/windows/Disk/DevCaches.cs" Link="windows/DevCaches.cs" />
    <Compile Include="../../src/windows/Keys/ScancodeMap.cs" Link="windows/ScancodeMap.cs" />
    <Compile Include="../../src/windows/Desktop/WallpaperPlan.cs" Link="windows/WallpaperPlan.cs" />
    <Compile Include="../../src/windows/Desktop/PipPlan.cs" Link="windows/PipPlan.cs" />
    <Compile Include="../../src/windows/Desktop/DisplayProfiles.cs" Link="windows/DisplayProfiles.cs" />
    <Compile Include="../../src/windows/Explorer/OpenWith.cs" Link="windows/OpenWith.cs" />
    <Compile Include="../../shell/menu-app/ViewerFile.cs" Link="windows/ViewerFile.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- The Wi-Fi code is checked by reading it back with the same library that drew it. -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
