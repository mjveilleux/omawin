# Rendered by omawin's themes/render.ps1 from themes/templates/noctty.ghostty: the current
# theme for noctty (Ghostty's config format). Don't edit the copy.
background = {{ background }}
foreground = {{ foreground }}
cursor-color = {{ accent }}
cursor-text = {{ background }}
selection-background = {{ selection }}
selection-foreground = {{ foreground }}
palette = 0={{ darker_background }}
palette = 1={{ red }}
palette = 2={{ green }}
palette = 3={{ yellow }}
palette = 4={{ blue }}
palette = 5={{ magenta }}
palette = 6={{ cyan }}
palette = 7={{ foreground }}
palette = 8={{ dark_foreground }}
palette = 9={{ bright_red }}
palette = 10={{ bright_green }}
palette = 11={{ bright_yellow }}
palette = 12={{ bright_blue }}
palette = 13={{ bright_magenta }}
palette = 14={{ bright_cyan }}
palette = 15={{ bright_foreground }}
# The tab strip and split dividers, in the theme's colors too. The strip a shade apart from the
# terminal's background, which the active tab is filled with, so the active tab stands out.
window-titlebar-background = {{ selection }}
window-titlebar-foreground = {{ foreground }}
split-divider-color = {{ selection }}
